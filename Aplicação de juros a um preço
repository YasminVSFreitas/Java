import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner teclado = new Scanner(System.in);

        System.out.print("Digite o valor: ");
        double valor = teclado.nextDouble();

        if (valor < 0) {
            System.out.println("Erro: valor negativo.");
        } else if (valor < 100) {
            valor = valor * 1.10;
            System.out.println("Novo valor: " + valor);
        } else if (valor < 300) {
            valor = valor * 1.20;
            System.out.println("Novo valor: " + valor);
        } else if (valor <= 1000) {
            valor = valor * 1.50;
            System.out.println("Novo valor: " + valor);
        } else {
            System.out.println("Valor acima de 1000, nenhuma taxa aplicada.");
            System.out.println("Novo valor: " + valor);
        }

        teclado.close();
    }
}
